menu "Weather display"

    config WEATHER_POLL_MINUTES
        int "Ecowitt poll / display refresh interval (minutes)"
        range 1 1440
        default 15
        help
            Refresh slots are aligned to multiples of this many minutes past
            local midnight (15 -> :00, :15, :30, :45). Pick a divisor of 1440.

    config WEATHER_FETCH_LEAD_SECONDS
        int "Start the data fetch this many seconds before each slot"
        range 0 600
        default 30

    config WEATHER_WAKE_LEAD_SECONDS
        int "Wake from deep sleep this many seconds before each slot"
        range 10 600
        default 60
        help
            Covers boot, Wi-Fi association, SNTP and RTC clock drift. Must be
            larger than WEATHER_FETCH_LEAD_SECONDS.

    config WEATHER_TZ
        string "POSIX timezone for date and last-update time"
        default "CET-1CEST,M3.5.0,M10.5.0/3"
        help
            Default is Central European Time (the station reports Europe/Zurich).

    config ECOWITT_MAC
        string "Ecowitt station MAC (leave empty to auto-detect)"
        default ""
        help
            If empty, the first device returned by /device/list for the API
            keys is used and cached in NVS.

endmenu
