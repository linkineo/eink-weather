CONFIG_IDF_TARGET="esp32s3"

# CrowPanel ESP32-S3-WROOM-1-N8R8: 8 MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# A little extra headroom for the main task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Wi-Fi + TLS + cJSON need more than the 1 MB default app partition.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# HTTPS to api.ecowitt.net, verified with the bundled CA certificates.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
